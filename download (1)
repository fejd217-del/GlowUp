:root{color-scheme:dark;font-family:Inter,system-ui,sans-serif;background:#08070e;color:#f7f5ff}*{box-sizing:border-box}body{margin:0;background:radial-gradient(ellipse at 85% 10%,#30124980,transparent 55%)}main{max-width:1040px;margin:auto;padding:32px 24px}header{display:flex;justify-content:space-between;font-weight:800;letter-spacing:3px}header small,.label{font-size:11px;color:#b89cfc}.hero{display:flex;align-items:center;gap:24px;padding:40px 0}.hero>div{flex:1}.hero img{width:42%;border-radius:24px}h1{font-size:clamp(32px,5vw,56px);line-height:1.08;margin:18px 0}p{line-height:1.6;color:#c8c1d7}.card{background:#15111f;border:1px solid #352344;border-radius:22px;padding:28px;margin:20px 0}h2{margin-top:0}#plans{display:flex;gap:14px;flex-wrap:wrap}.plan{flex:1;min-width:180px;background:#21162f;padding:22px;border-radius:16px}.price{font-size:30px;font-weight:800;color:#fff}.button,button{display:inline-block;border:0;border-radius:12px;background:#a05af6;color:white;padding:13px 20px;font-weight:700;cursor:pointer;text-decoration:none}button:disabled{opacity:.4;cursor:default}button:hover,.button:hover{background:#b679ff}button{margin:8px 0}.muted,footer{font-size:13px;color:#a79bb9}.payment{display:flex;gap:26px}.payment img{width:200px;height:200px;background:white;padding:12px;border-radius:14px}.payment>div{min-width:0}label{display:block;margin-top:14px;font-size:12px;color:#bca3d4}code{display:block;overflow-wrap:anywhere;color:#ede1ff;padding:12px 0}#error{color:#ffb9c9}footer{margin:30px 0}[hidden]{display:none!important}@media(max-width:600px){.hero{display:block}.hero img{width:100%;max-height:300px;object-fit:cover;margin-top:20px}.payment{display:block}.card{padding:20px}header small{display:none}}
